{
  "id": "auto-rename",
  "name": "自动会话重命名",
  "description": "新对话自动命名。代码侧零限制，标题质量完全由模型提示词决定。",
  "version": "0.2.8",
  "activation": {
    "onStartup": true
  },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "enabled": {
        "type": "boolean",
        "default": true,
        "description": "启用自动重命名"
      },
      "pollIntervalMs": {
        "type": "integer",
        "default": 8000,
        "minimum": 2000,
        "maximum": 60000,
        "description": "轮询间隔（毫秒）"
      },
      "titleMaxLen": {
        "type": "integer",
        "default": 10,
        "minimum": 3,
        "maximum": 20,
        "description": "文本回退模式的标题最大字数；LLM 模式固定要求输出少于 10 字符"
      },
      "mode": {
        "type": "string",
        "default": "llm",
        "enum": ["llm", "extract"],
        "description": "标题生成模式: llm=调用LLM生成摘要, extract=从首条消息提取"
      },
      "retryMaxAttempts": {
        "type": "integer",
        "default": 5,
        "minimum": 1,
        "maximum": 300,
        "description": "本地 LLM 不可用时的最大轮询重试次数，超出后才使用文本回退"
      },
      "llmEndpoint": {
        "type": "string",
        "default": "http://localhost:8081/v1/chat/completions",
        "description": "LLM API端点（默认本地 llama-server）"
      },
      "llmModel": {
        "type": "string",
        "default": "Qwen3VL-2B-Instruct-Q4_K_M.gguf",
        "description": "LLM模型名（默认本地 Qwen3VL 2B GGUF）"
      },
      "llmApiKey": {
        "type": "string",
        "description": "LLM API密钥（留空则自动读取OpenClaw配置）"
      }
    }
  }
}
